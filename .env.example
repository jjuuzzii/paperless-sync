PAPERLESS_URL=http://localhost:8000
PAPERLESS_TOKEN=your_paperless_api_token_here
COMPANY_NAME=Your Company Name
# Optional: nur noetig, wenn die Paperless-URL per mTLS (z.B. Cloudflare Access)
# mit einem PKCS#12-Client-Zertifikat abgesichert ist. Ueber den Setup-Screen
# in der App (Schritt 1) bequemer konfigurierbar als von Hand.
PAPERLESS_CLIENT_CERT_PATH=
PAPERLESS_CLIENT_CERT_PASSWORD=
