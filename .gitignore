# Secrets
.env
paperless_client_cert.p12
# Sicherheitsnetz: ein Enable-Banking-Schluessel darf nie hier landen (lebt
# immer ausserhalb des Repos, siehe config_manager.get_enable_banking_key_path),
# aber falls doch mal jemand von Hand eine .pem-Datei in den Projektordner legt.
*.pem

# Laufzeitdaten
/input/*
!/input/.gitkeep
!/input/beispiel_kontoauszug.csv
/export/*
!/export/.gitkeep
session_state.json
session_state.json.tmp

# Python
__pycache__/
*.pyc
.venv/
venv/

# PyInstaller-Zwischen-Cache (NICHT der Ordner build/ - der enthaelt jetzt
# die eigenen Build-Skripte/.spec-Dateien/installer.iss/icon.ico, siehe
# build/build.py und dessen --workpath-Argument)
/.pyinstaller-work/
/dist/
*.spec.bak

# Inno-Setup-Installer-Ausgabe
/installer_output/

# Claude Code Arbeitsverzeichnis (lokale Harness-Zustandsdatei, nicht Teil des Projekts)
/.claude/
